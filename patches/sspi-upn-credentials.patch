--- a/src/auth_identity.rs
+++ b/src/auth_identity.rs
@@ -235,9 +235,22 @@
     fn from(credentials: AuthIdentity) -> Self {
         let password: &str = credentials.password.as_ref().as_ref();
 
+        // A UPN is stored whole in `user` with an empty `domain`, the way Windows clients send it.
+        // Splitting it at the `@` sends the UPN suffix as a NetBIOS domain (`suffix\account`), and the
+        // server can not log on e.g. a Microsoft account. It also round-trips through
+        // `TryFrom<&AuthIdentityBuffers>`, which recovers the UPN via its `@`.
+        // Same behaviour as sspi >= 0.21.3.
+        let (user, domain) = match credentials.username.format() {
+            UserNameFormat::UserPrincipalName => (credentials.username.inner(), ""),
+            UserNameFormat::DownLevelLogonName => (
+                credentials.username.account_name(),
+                credentials.username.domain_name().unwrap_or_default(),
+            ),
+        };
+
         Self {
-            user: credentials.username.account_name().into(),
-            domain: credentials.username.domain_name().unwrap_or_default().into(),
+            user: user.into(),
+            domain: domain.into(),
             password: ZeroizedUtf16String(password.into()).into(),
         }
     }
@@ -636,4 +649,31 @@
             check_round_trip_property(&username);
         })
     }
+
+    #[test]
+    fn upn_identity_buffers_keep_the_whole_upn() {
+        let identity = AuthIdentity {
+            username: Username::parse("user@example.com").expect("UPN"),
+            password: String::from("secret").into(),
+        };
+
+        let buffers = AuthIdentityBuffers::from(identity.clone());
+        assert_eq!(buffers.user.to_string(), "user@example.com");
+        assert!(buffers.domain.is_empty());
+
+        let round_trip = AuthIdentity::try_from(&buffers).expect("round trip");
+        assert_eq!(round_trip.username, identity.username);
+    }
+
+    #[test]
+    fn down_level_identity_buffers_keep_the_split() {
+        let identity = AuthIdentity {
+            username: Username::parse("HOST\\user").expect("down-level logon name"),
+            password: String::from("secret").into(),
+        };
+
+        let buffers = AuthIdentityBuffers::from(identity);
+        assert_eq!(buffers.user.to_string(), "user");
+        assert_eq!(buffers.domain.to_string(), "HOST");
+    }
 }
