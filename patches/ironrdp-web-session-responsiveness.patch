+/// Minimum time between two canvas blits. Graphics updates are coalesced into
+/// a single dirty region and painted at most this often.
+const DRAW_INTERVAL_MS: u32 = 16;
+
+/// Upper bound on the number of RDP frames processed between two yields to the
+/// browser event loop.
+const MAX_FRAMES_PER_YIELD: u32 = 16;
+
+/// One-shot ticker used to give a pending paint a deadline.
+///
+/// This is deliberately not an `IntervalStream`: an idle session must not wake
+/// up 60 times per second, so the ticker is armed only while there is
+/// something to paint, and it disarms itself once it fires.
+struct PaintTicker {
+    delay: u32,
+    armed: Rc<Cell<bool>>,
+    deadline: Option<TimeoutFuture>,
+}
+
+/// Handle used to arm a [`PaintTicker`] from inside the session loop, where the
+/// ticker itself is borrowed by the `select!` expression.
+#[derive(Clone)]
+struct PaintTrigger(Rc<Cell<bool>>);
+
+impl PaintTrigger {
+    fn trigger(&self) {
+        self.0.set(true);
     }
 }
 
+impl PaintTicker {
+    fn new(delay: u32) -> (Self, PaintTrigger) {
+        let armed = Rc::new(Cell::new(false));
+        let trigger = PaintTrigger(armed.clone());
+        let this = Self {
+            delay,
+            armed,
+            deadline: None,
+        };
+        (this, trigger)
+    }
+}
+
+impl Stream for PaintTicker {
+    type Item = ();
+
+    fn poll_next(self: Pin<&mut Self>, cx: &mut Context<'_>) -> Poll<Option<()>> {
+        let this = self.get_mut();
+
+        if !this.armed.get() {
+            this.deadline = None;
+            return Poll::Pending;
+        }
+
+        let deadline = this.deadline.get_or_insert_with(|| TimeoutFuture::new(this.delay));
+
+        match Pin::new(deadline).poll(cx) {
+            Poll::Ready(()) => {
+                this.deadline = None;
+                this.armed.set(false);
+                Poll::Ready(Some(()))
+            }
+            Poll::Pending => Poll::Pending,
+        }
+    }
+}
+
+/// Smallest rectangle containing both `a` and `b`.
+fn union_rect(a: InclusiveRectangle, b: InclusiveRectangle) -> InclusiveRectangle {
+    InclusiveRectangle {
+        left: a.left.min(b.left),
+        top: a.top.min(b.top),
+        right: a.right.max(b.right),
+        bottom: a.bottom.max(b.bottom),
+    }
+}
